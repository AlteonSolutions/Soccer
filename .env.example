# Every variable the code reads, and nothing else. Read in exactly one place:
# packages/shared/src/config.ts. Add a line here in the same commit as the code that reads a new var.
#
# Each entry says whether it is REQUIRED (the app refuses to start without it and names it) or
# OPTIONAL (a default applies). Anything secret shows where it comes from, never a value.
# In Azure these are app settings, set by infra/main.bicep; .env is for local development only.

# OPTIONAL — runtime mode: development | test | production. Default: development.
NODE_ENV=development

# OPTIONAL — log verbosity: fatal | error | warn | info | debug | trace. Default: info.
LOG_LEVEL=info

# OPTIONAL — Azure Table Storage. Default is Azurite (`pnpm run dev:storage`), so a fresh clone
# needs no Azure account. Production value: the storage account's connection string, set by Bicep.
# To read it yourself: az storage account show-connection-string -n <account> -g <resource-group>
STORAGE_CONNECTION_STRING=UseDevelopmentStorage=true

# OPTIONAL — Azure Communication Services connection string. Absent = every email is captured,
# never sent. Secret; set by Bicep in Azure. To read it yourself:
#   az communication list-key -n <comms-resource> -g <resource-group> --query primaryConnectionString
ACS_CONNECTION_STRING=

# OPTIONAL — sender address on the verified email domain (e.g. snacks@example.org). Required when
# EMAIL_LIVE=on.
EMAIL_FROM=

# OPTIONAL — on | off. Capture-vs-send flag; off (the default) records emails in memory and logs
# them instead of sending. Turn on only in Azure, after the sender domain is verified.
EMAIL_LIVE=off

# OPTIONAL — where "nobody signed up for Saturday" nudges go. Empty disables the nudge.
COACH_EMAIL=

# OPTIONAL — IANA time zone the team lives in; decides what "today" is, and therefore which day is
# Monday (snack reminder) and Thursday (team reminder). Default: America/New_York.
TIMEZONE=America/New_York

# OPTIONAL — shared secret the daily scheduler presents to POST /api/jobs/reminders. Absent = the
# endpoint is disabled. In Azure the Bicep sets it on the Static Web App and the Logic App from the
# same value. Locally, to poke the endpoint: JOB_KEY=$(openssl rand -hex 32)
JOB_KEY=

# OPTIONAL — team name shown on the site and in emails. Default: Our Team.
TEAM_NAME=Manchester City

# OPTIONAL — public URL used in emails. Default: the SWA CLI's local address.
SITE_URL=http://localhost:4280
