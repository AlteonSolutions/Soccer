# Every variable the code reads, and nothing else. Read in exactly one place:
# packages/shared/src/config.ts. Add a line here in the same commit as the code that reads a new var.
#
# Each entry says whether it is REQUIRED (the app refuses to start without it and names it) or
# OPTIONAL (a default applies). Anything secret shows the command that generates it, never a value.

# OPTIONAL — runtime mode: development | test | production. Default: development.
NODE_ENV=development

# OPTIONAL — TCP port the web app listens on. Default: 3000.
PORT=3000

# OPTIONAL — log verbosity: fatal | error | warn | info | debug | trace. Default: info.
LOG_LEVEL=info
