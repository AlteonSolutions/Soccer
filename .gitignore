node_modules/
dist/
coverage/
.env
*.log
*.tsbuildinfo

# Claude Code. Comments stay on their own line: git treats a trailing "# …" as part of the pattern,
# and the template's inline comments silently un-ignored settings.local.json.
# per-machine permissions; never shared
.claude/settings.local.json
# restored from the `worklog` branch by the SessionStart hook
.claude/sessions.csv

# Customer data — blocked by format, sanitized fixtures whitelisted below by exception.
# Add a `!test/fixtures/<file>` line per fixture, never a blanket un-ignore.
*.xlsx
*.xlsm
*.csv
*.mdb
*.accdb
*.bak
# The league schedule PDF carries coaches' phone numbers and emails. Only the made-up fixture is allowed.
*.pdf
!test/fixtures/*.csv
!apps/web/test/fixtures/schedule-sample.pdf
!apps/web/test/fixtures/roster-sample.pdf

# Local emulator state and Functions-host settings; both machine-local, never shared.
.azurite/
local.settings.json
.swa/
