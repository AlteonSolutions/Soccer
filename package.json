{
  "name": "soccer",
  "version": "0.1.0",
  "private": true,
  "description": "A small web app for a kids' soccer team: snack sign-up and reminder emails for parents.",
  "type": "module",
  "engines": {
    "node": "22"
  },
  "packageManager": "pnpm@10.33.0",
  "scripts": {
    "setup": "node scripts/setup.mjs",
    "dev": "pnpm -r --parallel --if-present run dev",
    "typecheck": "tsc -p tsconfig.json --noEmit && pnpm -r run typecheck",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "build": "pnpm -r --if-present run build",
    "gate": "pnpm run typecheck && pnpm run lint && pnpm run format:check && pnpm test"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^22.20.1",
    "eslint": "^10.10.0",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^17.12.0",
    "prettier": "^3.9.6",
    "typescript": "^5.9.0",
    "typescript-eslint": "^8.69.0",
    "vitest": "^3.2.0"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild"
    ]
  }
}
